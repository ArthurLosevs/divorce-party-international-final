  "dependencies": { "next": "16.3.8", "react": "19.3.0", "react-dom": "19.3.0", "lucide-react": "1.50.0" },
  "devDependencies": { "typescript": "7.0.2", "@types/node": "26.6.4", "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "eslint": "10.11.0", "eslint-config-next": "16.3.8", "tsx": "4.23.15", "@playwright/test": "1.63.0" },
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.15.0" }
}
